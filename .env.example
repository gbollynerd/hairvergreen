# ─── Public (safe to expose to the browser) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.hairvergreen.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Paystack public key (pk_test_… / pk_live_…)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ─── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ───────────────────
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Paystack secret key (sk_test_… / sk_live_…). Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
# Transactional email (optional — emails are logged and skipped when unset)
RESEND_API_KEY=
EMAIL_FROM="Hairver Green <orders@hairvergreen.com>"
# Comma-separated emails that are automatically granted Super Admin on sign-in (bootstrap only)
BOOTSTRAP_SUPER_ADMIN_EMAILS=
# Random string protecting /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
